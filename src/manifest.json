{
  "manifest_version": 3,
  "name": "B站视频直链助手",
  "version": "1.1.1",
  "description": "一键解析B站视频CDN直链（免登录720P），复制给VRChat等播放器使用；可配置自建解析服务生成稳定链接。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站视频直链助手",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
